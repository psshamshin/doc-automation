{
  "_about": "Правила отбора. Описание: docs/RULES.md.",
  "diff_exclude_globs": [
    "*/node_modules/*",
    "*.map",
    "package-lock.json",
    "*/package-lock.json",
    "*/CHANGELOG.md",
    "CHANGELOG.md"
  ],
  "file_categories": [
    {
      "name": "changelog",
      "globs": [
        "*/changelogs/*"
      ]
    },
    {
      "name": "test",
      "globs": [
        "cypress/*",
        "*/cypress/*",
        "*.test.*",
        "*.spec.*",
        "*/__tests__/*",
        "*/tests/*",
        "*/e2e/*",
        "*/vitest.config.*"
      ]
    },
    {
      "name": "ci",
      "globs": [
        ".gitlab-ci.yml",
        "*/.gitlab-ci.yml",
        "*/docker/*",
        "*Dockerfile*"
      ]
    },
    {
      "name": "build",
      "globs": [
        "package.json",
        "*/package.json",
        "*vite.config*",
        "nx.json",
        "lerna.json",
        "tsconfig*.json",
        "*/tsconfig*.json",
        "eslint.config.*",
        "tools/*",
        "*/i18next-parser.config.js",
        "generate*.js"
      ]
    },
    {
      "name": "mocks",
      "globs": [
        "*/mocks/*",
        "*mockServiceWorker*",
        "*/fixtures/*",
        "*/__mocks__/*"
      ]
    },
    {
      "name": "i18n",
      "globs": [
        "*/i18n.ts",
        "*/i18n.js",
        "*/i18n/*",
        "*/translations/*"
      ]
    },
    {
      "name": "types",
      "globs": [
        "types/*",
        "*.d.ts"
      ]
    },
    {
      "name": "style",
      "globs": [
        "*.sass",
        "*.scss",
        "*.css"
      ]
    },
    {
      "name": "assets",
      "globs": [
        "*.svg",
        "*.png",
        "*.jpg",
        "*.jpeg",
        "*.ttf",
        "*/images/*",
        "*/branding/*",
        "*/fonts/*"
      ]
    },
    {
      "name": "docs_internal",
      "globs": [
        "*.md"
      ]
    }
  ],
  "attribution": {
    "app_dir": "apps/point",
    "entry_dirs": [
      "apps/point/src"
    ],
    "package_dirs": [
      "monokit",
      "pages",
      "shared",
      "api",
      "api-bindings",
      "permissions"
    ],
    "ignore_tags": [
      "point",
      "point2",
      "point3",
      "app",
      "cypress",
      "e2e",
      "tests",
      "vitest",
      "deps",
      "build"
    ],
    "tag_aliases": {
      "video analytics": "pages/video-analytics",
      "videoanalytics": "pages/video-analytics"
    }
  },
  "product": {
    "jira_point_tag": "point",
    "other_app_dirs": [
      "apps/point3",
      "apps/clementine",
      "apps/luna"
    ],
    "other_product_file_markers": [
      ".point3."
    ],
    "text_markers": {
      "point3": {
        "tags": [
          "point3"
        ],
        "regex": [
          "\\.point3\\b",
          "\\bpoint\\s?3\\b",
          "\\bпоинт\\s?3\\b"
        ],
        "unless_regex": [
          "\\bpoint\\s+(и|and)\\s+point\\s?3",
          "\\bpoint\\s?3\\s+(и|and)\\s+point\\b",
          "point\\s?2"
        ]
      },
      "clementine": {
        "tags": [
          "checks"
        ],
        "regex": [
          "\\bclem",
          "клементин"
        ],
        "unless_regex": []
      }
    },
    "jira_other_tags": [
      "point3",
      "clementine",
      "luna-ui",
      "luna"
    ]
  },
  "visibility": {
    "invisible_categories": [
      "test",
      "changelog",
      "build",
      "ci",
      "types",
      "mocks",
      "docs_internal"
    ],
    "test_tags": [
      "cypress",
      "e2e",
      "tests",
      "vitest"
    ],
    "ui_keywords": [
      "отображ",
      "кнопк",
      "фильтр",
      "поле",
      "поля",
      "страниц",
      "меню",
      "раздел",
      "валидац",
      "подтвержд",
      "сообщени",
      "модальн",
      "колонк",
      "таблиц",
      "вкладк",
      "форм",
      "пользовател",
      "заголов",
      "прокрутк",
      "скролл",
      "тема ",
      "тему",
      "локал",
      "язык",
      "адресн",
      "сброс",
      "сохран",
      "загрузк",
      "создани",
      "название",
      "подсказ",
      "плейсхолдер",
      "placeholder",
      "обязательн",
      "интерфейс"
    ],
    "technical_keywords": [
      "рефакторинг",
      "переведён на",
      "переведен на",
      "вынесен",
      "перенесён",
      "перенесен",
      "типизац",
      "тест",
      "eslint",
      "линтер",
      "зависимост",
      "сериализац",
      "хук",
      "redux",
      "контекст",
      "адаптер",
      "fsd",
      "сборк",
      "скелетон",
      "storybook",
      "unused",
      "неиспользуем",
      "переиспользуем",
      "компонент `",
      "перепривязан",
      "импорт",
      "ложные ошибки"
    ],
    "technical_strong_keywords": [
      "рефакторинг",
      "переведён на",
      "переведен на",
      "вынесен",
      "перенесён",
      "перенесен",
      "перепривязан"
    ],
    "code_reference_regex": [
      "`[^`]+`",
      "\\b[A-Za-z][\\w.-]*/[A-Za-z][\\w./-]*",
      "\\b[A-Z][a-z0-9]+(?:[A-Z][a-z0-9]+)+\\b"
    ],
    "style_keywords": [
      "стил",
      "отступ",
      "шрифт",
      "цвет",
      "анимац"
    ]
  },
  "i18n": {
    "file_globs": [
      "*/i18n.ts",
      "*/i18n.js",
      "*/i18n/*.ts",
      "*/translations/*.ts",
      "*/translations/*/*.ts"
    ],
    "locale_export_names": {
      "ru": [
        "ru",
        "ruRu",
        "entitiesRu"
      ],
      "en": [
        "en",
        "enUs",
        "entitiesEn"
      ],
      "pt": [
        "ptBr",
        "entitiesPtBr"
      ],
      "es": [
        "esEs",
        "entitiesEsEs"
      ]
    },
    "diff_locales": [
      "ru",
      "en"
    ],
    "app_translations_dir": "apps/point/src/app/translations",
    "doc_lang_of_locale": {
      "ru": "rus",
      "en": "eng"
    }
  },
  "class": {
    "locale_tags": [
      "i18n"
    ],
    "locale_keywords": [
      "локал",
      "язык"
    ],
    "locale_doc_areas": [
      "locales"
    ]
  }
}
