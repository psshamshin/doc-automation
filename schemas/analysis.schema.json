{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "07_analysis.json — результат шага 3",
  "type": "object",
  "required": ["release", "units"],
  "properties": {
    "release": {"type": "string"},
    "units": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "product", "visible", "class", "in_doc", "user_change"],
        "properties": {
          "id": {"type": "string", "description": "GUI-xxxx или NOCL:<путь>"},
          "source": {"enum": ["changelog", "code_only"], "default": "changelog"},
          "product": {"enum": ["point2", "other", "needs_human"]},
          "visible": {"type": "boolean"},
          "class": {"enum": ["Д1", "Д2", "Д3", "Д4", "Д5", "Д6", "Д7", "Д8", "Д9", "Д10", "Д11", null]},
          "in_doc": {"type": "boolean", "description": "нужна правка руководства"},
          "user_change": {
            "type": "object",
            "description": "что изменилось для пользователя",
            "properties": {
              "screen": {"type": "string"},
              "element": {"type": "string"},
              "before": {"type": "string"},
              "after": {"type": "string"},
              "ui_strings": {"type": "object", "properties": {"ru": {"type": "array", "items": {"type": "string"}}, "en": {"type": "array", "items": {"type": "string"}}}}
            }
          },
          "evidence": {"type": "array", "items": {"type": "string"}, "description": "файл:строка или строка ченджлога, подтверждающие вывод"},
          "release_note": {
            "type": ["object", "null"],
            "properties": {"section": {"enum": ["changes", "fixes"]}, "ru": {"type": "string"}, "en": {"type": "string"}}
          },
          "override_reason": {"type": "string", "description": "если решение шага 2 изменено"},
          "open_questions": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
