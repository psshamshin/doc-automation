{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "08_plan.json — результат шага 4",
  "type": "object",
  "required": ["release", "actions"],
  "properties": {
    "release": {"type": "string"},
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "lang", "file", "action"],
        "properties": {
          "unit": {"type": "string"},
          "lang": {"enum": ["rus", "eng", "both"]},
          "file": {"type": "string", "description": "путь от docs/src/MD_<lang>/docs"},
          "anchor": {"type": "string", "description": "заголовок раздела или цитата строки"},
          "line": {"type": "integer"},
          "action": {"enum": ["insert", "replace", "delete", "check", "screenshot", "needs_decision"]},
          "what": {"type": "string", "description": "что именно поменять"},
          "image": {"type": "string", "description": "для screenshot: путь картинки"},
          "rules": {"type": "array", "items": {"type": "string"}},
          "options": {"type": "array", "items": {"type": "string"}, "description": "для needs_decision"}
        }
      }
    }
  }
}
